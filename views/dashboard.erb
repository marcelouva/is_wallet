<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tu cuenta - IS Wallet</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f4f7fc;
            margin: 0;
            display: flex;
            flex-direction: column;
            height: 100vh;
        }

        .header {
            background-color: #3498db;
            color: white;
            padding: 15px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .user-info {
            display: flex;
            align-items: center;
        }

        .form-row {
            display: flex;
            gap: 20px; /* Espacio entre los elementos */
        }

        .user-info img {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            margin-right: 10px;
        }

        .tabs {
            display: flex;
            justify-content: center;
            margin-top: 10px;
        }

        .tab {
            padding: 10px 20px;
            cursor: pointer;
            background-color: #ddd;
            border: none;
            border-radius: 6px 6px 0 0;
            margin: 0 5px;
            font-size: 16px;
            font-weight: bold;
        }

        .tab.active {
            background-color: #3498db;
            color: white;
        }

        .tab-content {
            display: none;
            padding: 20px;
            background-color: white;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            border-radius: 0 0 6px 6px;
            max-width: 600px;
            margin: auto;
            text-align: center;
        }

        .tab-content.active {
            display: block;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            margin-bottom: 10px;
        }

        .form-group label {
            font-size: 14px;
            font-weight: bold;
        }

        .form-group input, .form-group select {
            width: 100%;
            padding: 8px;
            border: 1px solid #ccc;
            border-radius: 4px;
        }

        .form-container {
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        button.button {
            padding: 12px 24px;
            font-size: 16px;
            font-weight: bold;
            background-color: #3498db;
            color: white;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            transition: background-color 0.3s ease, transform 0.2s ease;
            margin-top: 10px;
        }

        button.button:hover {
            background-color: #2980b9;
            transform: translateY(-2px);
        }

        button.button:active {
            background-color: #1f6d8c;
            transform: translateY(0);
        }

        button.button:disabled {
            background-color: #ddd;
            cursor: not-allowed;
        }

        #transferFields {
            display: none;
            margin-top: 20px;
        }
    </style>

    <script>
        function openTab(tabName) {
            document.querySelectorAll('.tab-content').forEach(tab => tab.classList.remove('active'));
            document.querySelector(`#${tabName}`).classList.add('active');
            document.querySelectorAll('.tab').forEach(tab => tab.classList.remove('active'));
            document.querySelector(`[data-tab="${tabName}"]`).classList.add('active');
        }

        function toggleTransferFields() {
            let transferFields = document.getElementById('transferFields');
            transferFields.style.display = (transferFields.style.display === 'none' || transferFields.style.display === '') ? 'block' : 'none';
        }
    </script>
</head>
<body>
    <div class="header">
        <h2>IS Wallet</h2>
        <div class="user-info">
            <img src="/images/user.png" alt="Usuario">
            <span><%= @username %></span>
        </div>
    </div>

    <div class="tabs">
        <button class="tab active" data-tab="wallet" onclick="openTab('wallet')">Mi Billetera</button>
        <button class="tab" data-tab="accounts" onclick="openTab('accounts')">Mis Cuentas</button>
    </div>

    <div id="wallet" class="tab-content active">
        <form action="/perform_transaction" method="post">
            <div class="form-group">
                <label for="account">Selecciona una cuenta</label>
                <select id="account" name="account" required>
                    <% @accounts.each do |account| %>
                        <option value="<%= account.id %>">
                            <%= account.bank_name %> - <%= account.cbu %> - <%= account.balance %>- <%= account.currency %>
                        </option>
                    <% end %>
                </select>
            </div>

            <div class="buttons">
                <button type="button" class="button" onclick="toggleTransferFields()">Transferir</button>
                <button type="submit" name="action" value="view_transactions" class="button">Ver Movimientos</button>
                <button type="submit" name="action" value="qr_payment" class="button">Pago con QR</button>
            </div>

            <div id="transferFields">
              <div class="form-group">
                  <label for="cbu">CVU o CBU</label>
                  <input type="text" id="cbu" name="cbu" required onblur="fetchAccountDetails()">
              </div>
              <div id="account-info" style="display: none; margin-top: 10px;">
                  <p><strong>Banco:</strong> <span id="bank-name"></span></p>
                  <p><strong>Titular:</strong> <span id="account-owner"></span></p>
                  <p><strong>Moneda:</strong> <span id="account-currency"></span></p>
              </div>

              <script>
                function fetchAccountDetails() {
                    const cbu = document.getElementById("cbu").value.trim();
                    console.log("Consultando CBU/Alias:", cbu);
                    if (cbu.length < 2) return; // Esperar hasta que haya al menos 2 caracteres
                     fetch(`/get_account_info?cbu=${encodeURIComponent(cbu)}`)
                      .then(response => response.json())
                      .then(data => {
                        console.log("Respuesta del servidor:", data);
                        if (data.success) {
                          document.getElementById("bank-name").textContent = data.bank_name;
                          document.getElementById("account-owner").textContent = data.full_name;
                          document.getElementById("account-currency").textContent = data.currency;

                          document.getElementById("account-info").style.display = "block";
                        } else {
                          document.getElementById("account-info").style.display = "none";
                          alert("Cuenta no encontrada.");
                        }
                      })
                      .catch(error => {
                          console.error("Error al obtener la información de la cuenta:", error);
                          alert("Hubo un error al consultar la cuenta.");
                        });
                  }
                </script>



                <div class="form-group">
                    <label for="reason">Motivo</label>
                    <input type="text" id="reason" name="reason" required>
                </div>

                <div class="form-group">
                    <label for="amount">Monto</label>
                    <input type="number" id="amount" name="amount" required>
                </div>

                <button type="submit" name="action" value="send_money" class="button">Confirmar Transferencia</button>
            </div>
        </form>
    </div>




    <div id="accounts" class="tab-content"  style="width: 80%;" >
        <% if @has_account %>
            <h3>Mis Cuentas</h3>
            <% @accounts.each do |account| %>
                <div class="account">
                    <strong>Banco:</strong> <%= account.bank_name %> - <strong>CVU/CBU:
                    </strong> <%= account.cbu %> - <strong>Alias:</strong> <%= account.alias %> -
                    <strong>Saldo:</strong> $<%= account.balance %> - <strong>Moneda:</strong> <%= account.currency %>
                </div>
                <hr>
            <% end %>
        <% end %>

        <h4>Agrega tu cuenta</h4>
        <form action="/add_account" method="post">
          <div class="form-row" >
            <div class="form-group"  style="width: 50%;">
              <label for="bank">Banco</label>
              <input type="text" id="bank" name="bank" required>
            </div>

            <div class="form-group" style="width: 50%;">
              <label for="cbu">CVU o CBU</label>
              <input type="text" id="cbu" name="cbu" required>
            </div>
          </div>

          <div class="form-row" >

            <div class="form-group" style="width: 50%;">
                <label for="alias">Alias:</label>
                <input type="text" id="alias" name="alias" required>
            </div>

              <div class="form-group" style="width: 50%;">
            <label for="currency">Moneda:</label>
              <select id="currency" name="currency" required>
                <option value="ARS">ARS</option>
                <option value="USD">USD</option>
                <option value="EUR">EUR</option>
              </select>
             </div>
           </div>

            <div class="form-group" style="width: 30%;">
                <label for="balance">Saldo:</label>
                <input type="text" id="balance" name="balance" required>
            </div>


            <button type="submit" class="button">Agregar Cuenta</button>
        </form>
    </div>
</body>
</html>
